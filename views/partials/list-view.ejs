<div class="box sorting">
  <h2>Sort By</h2>
  <form class="select-form" action="/sort" method="post">
    <select id="sortSelect" name="sort" value="<%= this %>">
      <option value="id">Created Date</option>
      <option value="item">Name</option>
      <option value="due_date">Complete By</option>
    </select>
    <select id="sortDirectionSelect" name="sortDirection" value="<%= this %>">
      <option value="ASC">Asc</option>
      <option value="DESC">Desc</option>
    </select>
  </form>
</div>
<script>
  const sortForm = document.querySelector('.select-form');
  const sortSelect = document.querySelector('#sortSelect');
  const sortDirectionSelect = document.querySelector('#sortDirectionSelect');

  sortSelect.value = '<%= sort %>';
  sortDirectionSelect.value = '<%= sortDirection %>';

  const updateSortedItems = async () => {
    const formData = new URLSearchParams(new FormData(sortForm));

    try {
      const response = await fetch('/sort', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          'X-Requested-With': 'fetch'
        },
        body: formData.toString()
      });

      if (!response.ok) {
        sortForm.submit();
        return;
      }

      const payload = await response.json();
      if (payload?.html) {
        const tableContainer = document.getElementById('listTableContainer');
        if (tableContainer) {
          tableContainer.outerHTML = payload.html;
        }
      }
    } catch (error) {
      sortForm.submit();
    }
  };

  sortSelect.addEventListener('change', updateSortedItems);
  sortDirectionSelect.addEventListener('change', updateSortedItems);
</script>

<%- include('list-table.ejs'); -%>
